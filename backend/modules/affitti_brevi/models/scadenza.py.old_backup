"""
Scadenza Model - Legal Deadline Tracking

Tracks deadlines for legal requirements:
- Police communications (Alloggiati Web) - within 24h of check-in
- ISTAT monthly reports - 1st of each month
- Other custom deadlines
"""
from sqlalchemy import Column, Integer, String, Date, DateTime, Boolean, Enum as SQLEnum, Text, ForeignKey
from sqlalchemy.orm import relationship
from sqlalchemy.sql import func
import enum
from app.core.database import Base

# Add modules directory to path for cross-module imports
import sys
import os
modules_dir = os.path.join(os.path.dirname(__file__), '../../../modules')
if modules_dir not in sys.path:
    sys.path.insert(0, modules_dir)


class TipoScadenza(str, enum.Enum):
    """Type of deadline"""
    COMUNICAZIONE_POLIZIA = "COMUNICAZIONE_POLIZIA"  # Police communication (within 24h)
    REPORT_ISTAT = "REPORT_ISTAT"                    # ISTAT monthly report
    ALTRO = "ALTRO"                                  # Custom deadline


class StatoScadenza(str, enum.Enum):
    """Deadline status"""
    DA_FARE = "DA_FARE"              # To do
    IN_SCADENZA = "IN_SCADENZA"      # Approaching (within 7 days)
    SCADUTA = "SCADUTA"              # Overdue
    COMPLETATA = "COMPLETATA"        # Completed


class Scadenza(Base):
    """
    Legal Deadline Tracking

    Manages deadlines for legal requirements in short-term rentals.
    Can be linked to specific bookings or be general deadlines.
    """
    __tablename__ = "scadenze"

    id = Column(Integer, primary_key=True, index=True)

    # Deadline type and status
    tipo_scadenza = Column(SQLEnum(TipoScadenza), nullable=False, index=True)
    stato = Column(SQLEnum(StatoScadenza), default=StatoScadenza.DA_FARE, nullable=False, index=True)

    # Deadline info
    titolo = Column(String(200), nullable=False,
                   comment="Titolo della scadenza")
    descrizione = Column(Text, nullable=True,
                        comment="Descrizione dettagliata")
    data_scadenza = Column(DateTime(timezone=True), nullable=False, index=True,
                          comment="Data e ora di scadenza")

    # Optional link to booking (for COMUNICAZIONE_POLIZIA)
    prenotazione_id = Column(Integer, ForeignKey("prenotazioni.id"),
                            nullable=True, index=True,
                            comment="Prenotazione associata (opzionale)")

    # Completion tracking
    completata = Column(Boolean, default=False, nullable=False, index=True)
    data_completamento = Column(DateTime(timezone=True), nullable=True,
                                comment="Data e ora di completamento")
    note_completamento = Column(Text, nullable=True,
                                comment="Note sul completamento")

    # Reminder tracking
    reminder_inviato = Column(Boolean, default=False, nullable=False,
                             comment="True se è stato inviato un reminder")
    data_reminder = Column(DateTime(timezone=True), nullable=True,
                          comment="Data invio ultimo reminder")

    # Recurrence (for REPORT_ISTAT)
    ricorrente = Column(Boolean, default=False, nullable=False,
                       comment="True se scadenza ricorrente")
    frequenza_giorni = Column(Integer, nullable=True,
                             comment="Giorni tra ricorrenze (es. 30 per mensile)")
    prossima_ricorrenza = Column(Date, nullable=True,
                                comment="Data prossima ricorrenza")

    # Timestamps
    created_at = Column(DateTime(timezone=True), server_default=func.now())
    updated_at = Column(DateTime(timezone=True), onupdate=func.now())

    # Relationships
    prenotazione = relationship("Prenotazione", foreign_keys=[prenotazione_id])

    def __repr__(self):
        return f"<Scadenza(id={self.id}, tipo={self.tipo_scadenza.value}, stato={self.stato.value}, scadenza={self.data_scadenza})>"

    @property
    def is_overdue(self):
        """Check if deadline is overdue"""
        from datetime import datetime, timezone
        if self.completata:
            return False
        return datetime.now(timezone.utc) > self.data_scadenza

    @property
    def is_approaching(self):
        """Check if deadline is approaching (within 7 days)"""
        from datetime import datetime, timezone, timedelta
        if self.completata:
            return False
        now = datetime.now(timezone.utc)
        seven_days = now + timedelta(days=7)
        return now < self.data_scadenza <= seven_days

    @property
    def giorni_rimanenti(self):
        """Calculate days remaining until deadline"""
        from datetime import datetime, timezone
        if self.completata:
            return None
        now = datetime.now(timezone.utc)
        delta = self.data_scadenza - now
        return delta.days

    def update_stato(self):
        """Update status based on current date"""
        if self.completata:
            self.stato = StatoScadenza.COMPLETATA
        elif self.is_overdue:
            self.stato = StatoScadenza.SCADUTA
        elif self.is_approaching:
            self.stato = StatoScadenza.IN_SCADENZA
        else:
            self.stato = StatoScadenza.DA_FARE

    def mark_completed(self, note: str = None):
        """Mark deadline as completed"""
        from datetime import datetime, timezone
        self.completata = True
        self.data_completamento = datetime.now(timezone.utc)
        self.note_completamento = note
        self.stato = StatoScadenza.COMPLETATA

    def generate_next_recurrence(self):
        """Generate next recurrence for recurring deadlines"""
        from datetime import timedelta
        if not self.ricorrente or not self.frequenza_giorni:
            return None

        if self.prossima_ricorrenza:
            next_date = self.prossima_ricorrenza + timedelta(days=self.frequenza_giorni)
        else:
            next_date = self.data_scadenza.date() + timedelta(days=self.frequenza_giorni)

        return next_date
