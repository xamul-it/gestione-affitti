# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/gestione_affitti

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# First Admin User (created automatically on first startup)
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=changeme123
FIRST_ADMIN_FULL_NAME=Administrator

# CORS Origins (comma separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# GenAI Configuration (Optional - for smart address parsing)
# Get free API key at: https://console.groq.com/
GROQ_API_KEY=

# Enable/disable GenAI fallback for address parsing
ENABLE_GENAI_FALLBACK=true

# Ollama Configuration (if running locally)
OLLAMA_BASE_URL=http://localhost:11434

# Notifiche — SMTP applicativo (usato da gestione_pec e dal reminder scadenzario)
# Se NOTIFICHE_SMTP_HOST è vuoto le notifiche email sono disabilitate.
NOTIFICHE_SMTP_HOST=
NOTIFICHE_SMTP_PORT=587
NOTIFICHE_SMTP_USER=
NOTIFICHE_SMTP_PASSWORD=
NOTIFICHE_SMTP_FROM_EMAIL=
NOTIFICHE_SMTP_TLS=STARTTLS

# Scadenzario — reminder automatico
REMINDER_GIORNI_PRIMA=3
